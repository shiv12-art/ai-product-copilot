{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/product-artifacts-enhanced.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/product-artifacts-enhanced.html",
      "dest": "/public/product-artifacts-enhanced.html"
    },
    {
      "src": "/artifacts",
      "dest": "/artifacts"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
